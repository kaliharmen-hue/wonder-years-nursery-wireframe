---
import SiteHeader from './SiteHeader.astro';
const { title, section, relatedHref, relatedLabel } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html><html lang="en-GB"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} | The Wonder Years Day Nursery</title><link rel="stylesheet" href={`${base}styles/global.css`}/></head><body><a class="skip-link" href="#main">Skip to content</a><div class="wireframe-banner">{title} page · Copy to be developed</div><SiteHeader current={section}/><main id="main"><section class="section"><div class="container"><p class="eyebrow">Page structure placeholder</p><h1>{title}</h1><p class="lead">Approved content for this page will be added as it is developed.</p>{relatedHref && relatedLabel && <a class="button button-secondary" href={`${base}${relatedHref}`}>{relatedLabel}</a>}</div></section></main></body></html>
