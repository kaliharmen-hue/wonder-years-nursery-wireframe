---
import SiteHeader from '../components/SiteHeader.astro';
const base = import.meta.env.BASE_URL;
const rooms = [
  { title: 'Ladybirds and Dragonflies', age: 'Babies and younger toddlers', text: 'Our separate baby unit provides a nurturing environment for children from six weeks to around two years old.' },
  { title: 'Bumble Bees and Caterpillars', age: 'Two to three years', text: 'Separate rooms support children as their confidence, communication and independence continue to grow.' },
  { title: 'Grasshoppers', age: 'Three years and over', text: 'Our preschool room offers new challenges and helps children prepare for school.' },
  { title: 'School-holiday care', age: 'Up to Year 6', text: 'School-age children are welcomed during the school holidays, subject to availability.' }
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Warm, flexible childcare in Wednesbury for children from six weeks to 11 years old, including holiday care up to Year 6." />
    <title>The Wonder Years Day Nursery | Homepage wireframe</title>
    <link rel="stylesheet" href={`${base}styles/global.css`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="wireframe-banner">Homepage wireframe · Content and layout for review</div>

    <SiteHeader current="home" />

    <main id="main">
      <section class="hero section">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">The Wonder Years Day Nursery · Wednesbury</p>
            <h1>Our care starts at the front door</h1>
            <p class="lead">Warm, flexible childcare in Wednesbury for children from six weeks to 11 years old, including holiday care for school-age children up to Year 6.</p>
            <p class="opening-hours"><strong>Open Monday to Friday, 7.30am to 6pm.</strong></p>
            <div class="button-row">
              <a class="button" href={`${base}contact/`}>Arrange a visit</a>
              <a class="button button-secondary" href={`${base}rooms/`}>Explore our nursery</a>
            </div>
          </div>
          <div class="image-placeholder hero-image"><span>Hero image placeholder</span><small>Real nursery photograph or carefully selected stock image</small></div>
        </div>
        <div class="container trust-strip" aria-label="Key nursery information">
          <span>Ofsted rated Good</span><span>Funded childcare from nine months</span><span>Flexible sessions</span><span>Freshly prepared meals</span>
        </div>
      </section>

      <section class="section">
        <div class="container split-grid">
          <div>
            <p class="eyebrow">Welcome to The Wonder Years</p>
            <h2>A nursery where every child is known</h2>
            <p>Choosing a nursery is a big decision. You want somewhere your child will feel safe, settled and understood, where the team takes the time to know them as an individual.</p>
            <p>Care is shaped around each child rather than expecting every child to fit the same routine.</p>
            <a class="text-link" href={`${base}about/`}>Learn more about us →</a>
          </div>
          <div class="image-placeholder portrait"><span>Supporting image placeholder</span><small>Staff member engaging with a child or preparing an activity</small></div>
        </div>
      </section>

      <section class="section section-muted">
        <div class="container">
          <p class="eyebrow">Essential information</p>
          <h2>Childcare designed to work around family life</h2>
          <div class="facts-grid">
            <article><h3>Ages</h3><p>Children from six weeks to 11 years old, including school-holiday care up to Year 6.</p></article>
            <article><h3>Opening hours</h3><p>Monday to Friday, 7.30am to 6pm.</p></article>
            <article><h3>Sessions</h3><p>Full-day care, five-hour sessions and hourly childcare, subject to availability.</p></article>
            <article><h3>Funded places</h3><p>Government-funded childcare is available from nine months for eligible families.</p></article>
          </div>
          <a class="button button-secondary" href={`${base}fees-funding-joining/`}>View sessions and funding</a>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <p class="eyebrow">Our rooms</p>
          <h2>The right environment for every stage</h2>
          <p class="section-intro">Separate spaces for babies, toddlers and preschool children allow routines, activities and resources to suit each stage of development.</p>
          <div class="cards-grid rooms-grid">
            {rooms.map((room) => (
              <article class="card room-card"><div class="image-placeholder card-image"><span>Room image</span></div><div class="card-body"><p class="card-kicker">{room.age}</p><h3>{room.title}</h3><p>{room.text}</p></div></article>
            ))}
          </div>
          <a class="button button-secondary" href={`${base}rooms/`}>Explore our rooms</a>
        </div>
      </section>

      <section class="section section-accent">
        <div class="container split-grid">
          <div>
            <p class="eyebrow">Learning and development</p>
            <h2>Learning built around your child</h2>
            <p>Our curriculum follows the Early Years Foundation Stage and is informed by Birth to 5 Matters, supporting children across the seven areas of learning and development.</p>
            <p>Children are observed by their key person and the wider team so activities can reflect their interests, progress and next steps.</p>
            <a class="text-link" href={`${base}learning-development/`}>Discover how children learn →</a>
          </div>
          <div class="image-placeholder landscape"><span>Learning image placeholder</span><small>Real activity area, creative table or learning environment</small></div>
        </div>
      </section>

      <section class="section">
        <div class="container split-grid reverse">
          <div class="image-placeholder landscape"><span>Settling-in image placeholder</span></div>
          <div>
            <p class="eyebrow">Settling in</p>
            <h2>Time to settle at their own pace</h2>
            <p>The first session usually lasts around 30 minutes. Further visits are arranged around how each child responds, gradually building up to two hours.</p>
            <p>The nursery offers as many free settling-in sessions as each child needs.</p>
            <a class="text-link" href={`${base}about/`}>How joining the nursery works →</a>
          </div>
        </div>
      </section>

      <section class="section section-muted">
        <div class="container funding-panel">
          <div><p class="eyebrow">Funded childcare</p><h2>Making funded hours work for your family</h2><p>Funded childcare is available for eligible families from nine months, with term-time and stretched options subject to availability.</p><a class="button" href={`${base}fees-funding-joining/`}>View funding and childcare options</a></div>
          <aside class="summary-card"><h3>At a glance</h3><ul><li>Funding from nine months</li><li>Term-time and stretched options</li><li>Tax-Free Childcare accepted</li><li>No separate food or activity charge</li></ul></aside>
        </div>
      </section>

      <section class="section visit-section">
        <div class="container visit-grid">
          <div><p class="eyebrow">Arrange a visit</p><h2>Come and see whether it feels right</h2><p>Meet the team, explore the rooms and talk about your child, the sessions you need and current availability.</p><a class="button" href={`${base}contact/`}>Arrange your nursery tour</a></div>
          <div class="location-card"><h3>Find us</h3><address>Arundel House<br />50 Church Hill<br />Wednesbury<br />West Midlands<br />WS10 9DJ</address><p><strong>Call:</strong> 0121 556 6979</p></div>
        </div>
      </section>
    </main>

    <footer class="site-footer"><div class="container footer-grid"><div><strong>The Wonder Years Day Nursery Limited</strong><p>Company number: 08212428<br />Ofsted URN: 2710425</p></div><div><p>Arundel House, 50 Church Hill<br />Wednesbury, WS10 9DJ</p></div><nav aria-label="Footer navigation"><a href={`${base}contact/`}>Contact</a></nav></div></footer>

  </body>
</html>
