---
import SiteHeader from '../components/SiteHeader.astro';
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Contact The Wonder Years Day Nursery, arrange a visit and find opening hours, directions and parking information." />
    <title>Contact and Arrange a Visit | The Wonder Years Day Nursery</title>
    <link rel="stylesheet" href={`${base}styles/global.css`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="wireframe-banner">Contact and Arrange a Visit wireframe · Enquiry form and FAQs for review</div>
    <SiteHeader current="contact" />
    <main id="main">
      <section class="section hero">
        <div class="container visit-grid">
          <div>
            <p class="eyebrow">Contact and arrange a visit</p>
            <h1>Come and see whether it feels right</h1>
            <p class="lead">Meet the team, explore the rooms and talk about your child, the sessions you need and current availability.</p>
            <div class="contact-details">
              <a href="tel:01215566979">0121 556 6979</a>
              <a href="mailto:manager@thewonderyearsdaynursery.com">manager@thewonderyearsdaynursery.com</a>
            </div>
            <div class="contact-facts">
              <article><h3>Opening hours</h3><p>Monday to Friday<br />7.30am to 6pm</p></article>
              <article><h3>Nursery address</h3><p>Arundel House<br />50 Church Hill<br />Wednesbury<br />West Midlands<br />WS10 9DJ</p></article>
            </div>
          </div>
          <div class="location-card">
            <h2>Find us</h2>
            <p>A small car park is available.</p>
            <p><strong>Sat nav for the car park:</strong><br />WS10 9DH, Reservoir Passage</p>
            <div class="image-placeholder map-placeholder" role="img" aria-label="Map placeholder showing the nursery location"><span>Map placeholder</span></div>
          </div>
        </div>
      </section>

      <section class="section section-muted">
        <div class="container">
          <p class="eyebrow">Send an enquiry</p>
          <h2>Tell us how we can help</h2>
          <form class="enquiry-form" onsubmit="event.preventDefault()">
            <div class="form-grid">
              <div class="form-field"><label for="parent-name">Your name</label><input id="parent-name" name="name" type="text" autocomplete="name" /></div>
              <div class="form-field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" /></div>
              <div class="form-field"><label for="phone">Telephone number</label><input id="phone" name="phone" type="tel" autocomplete="tel" /></div>
              <div class="form-field"><label for="child-age">Child’s age</label><input id="child-age" name="child-age" type="text" /></div>
              <div class="form-field form-field-full"><label for="message">Your enquiry</label><textarea id="message" name="message"></textarea></div>
            </div>
            <button class="button" type="submit">Send enquiry</button>
          </form>
        </div>
      </section>

      <section id="faqs" class="section section-accent">
        <div class="container">
          <p class="eyebrow">Frequently asked questions</p>
          <h2>Questions parents often ask</h2>
          <div class="faq-placeholder">
            <h3>FAQ copy to be added</h3>
            <p>Approved questions and answers will be added here as the content is developed.</p>
          </div>
        </div>
      </section>
    </main>
    <footer class="site-footer"><div class="container footer-grid"><div><strong>The Wonder Years Day Nursery Limited</strong><p>Company number: 08212428<br />Ofsted URN: 2710425</p></div><div><p>Arundel House, 50 Church Hill<br />Wednesbury, West Midlands, WS10 9DJ</p></div><nav aria-label="Footer navigation"><a href={`${base}contact/`}>Contact</a><a href={`${base}contact/#faqs`}>FAQs</a></nav></div></footer>
  </body>
</html>
