const initials = (name) => name.split(' ').map((part) => part[0]).join('');
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Meet the nursery practitioners, managers and support staff at The Wonder Years Day Nursery." />
    <title>Meet the Team | The Wonder Years Day Nursery</title>
    <link rel="stylesheet" href={`${base}styles/global.css`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="wireframe-banner">Meet the Team wireframe · Content and image placement for review</div>

    <SiteHeader current="about" />

    <main id="main">
      <section class="section hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">The people who care for your child</p>
            <h1>Meet the team</h1>
            <p class="lead">The Wonder Years team brings together nursery practitioners, senior staff, managers and support staff who help care for children throughout the nursery day.</p>
            <p>Each member of the team contributes different experience, interests and skills, while working together to help children feel safe, known and supported.</p>
          </div>
          <div class="image-placeholder hero-image" role="img" aria-label="Placeholder for an approved non-identifiable nursery environment photograph">
            <span>Nursery environment image placeholder</span>
            <small>Staff preparing an activity or another approved non-identifiable nursery image</small>
          </div>
        </div>
      </section>

      {groups.map((group, groupIndex) => (
        <section class={`section ${groupIndex % 2 === 0 ? 'section-muted' : ''}`}>
          <div class="container">
            <h2>{group.name}</h2>
            <div class="team-grid">
              {group.staff.map((person) => (
                <article class="staff-card">
                  <div class="staff-photo" role="img" aria-label={`Staff photo placeholder for ${person.name}`}>
                    <span class="staff-initials" aria-hidden="true">{initials(person.name)}</span>
                    <small>Staff photo placeholder</small>
                  </div>
                  <div class="staff-card-body">
                    <h3>{person.name}</h3>
                    <p class="staff-title">{person.title}</p>
                    <dl class="staff-details">
                      <div><dt>Based in</dt><dd>{person.based}</dd></div>
                      <div><dt>Qualifications</dt><dd>{person.qualifications}</dd></div>
                      <div><dt>Joined The Wonder Years</dt><dd>{person.joined}</dd></div>
                      <div><dt>Favourite activity with the children</dt><dd>{person.favourite}</dd></div>
                      <div><dt>Outside the nursery</dt><dd>{person.outside}</dd></div>
                    </dl>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      ))}

      <section class="final-cta">
        <div class="container">
          <h2>Come and meet the team</h2>
          <p>The best way to get a feel for the nursery is to visit, explore the rooms and meet the people who will be caring for your child.</p>
          <div class="button-row centred">
            <a class="button button-light" href={`${base}contact/`}>Arrange a nursery visit</a>
            <a class="button button-outline-light" href="tel:01215566979">Call 0121 556 6979</a>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />

  </body>
</html>
