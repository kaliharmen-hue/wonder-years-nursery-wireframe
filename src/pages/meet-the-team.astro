    staff: [
      { name: 'Shannon James', title: 'Nursery Practitioner', based: 'Ladybirds, ages birth to two', qualifications: 'Level 2, currently completing Level 3', joined: '2024', favourite: 'Water play.', outside: 'Watching West Bromwich Albion football.' },
      { name: 'Jessica Hill', title: 'Nursery Practitioner', based: 'Ladybirds, ages birth to two', qualifications: 'Level 3 Early Years', joined: '2018', favourite: 'Reading stories, especially The Gruffalo.', outside: 'Baking.' },
      { name: 'Aimee Collins', title: 'Nursery Practitioner', based: 'Ladybirds, ages birth to two', qualifications: 'Level 3 Early Years', joined: '2020', favourite: 'Circle time.', outside: 'Being a dog mum.' },
      { name: 'Chantel Jones', title: 'Nursery Practitioner', based: 'Ladybirds, ages birth to two', qualifications: 'Level 3 Early Years', joined: '2023', favourite: 'Crafting and colouring.', outside: 'Travelling to different places.' },
    ],
  },
  {
    name: 'Dragonflies',
    staff: [
      { name: 'Rachael Jones', title: 'Senior Nursery Practitioner and Safeguarding Lead', based: 'Dragonflies, ages 18 months to two years', qualifications: 'Level 3 Early Years', joined: '2016', favourite: 'Outdoor play.', outside: 'Going to the caravan with her dog.' },
      { name: 'Ruth Tyson', title: 'Nursery Practitioner', based: 'Dragonflies, ages 18 months to two years', qualifications: 'Level 3 Early Years', joined: '2017', favourite: 'Circle time, reading stories and dancing.', outside: 'Reading a good book and spending time with family and friends.' },
