    ],
  },
  {
    name: 'Caterpillars',
    staff: [
      { name: 'Afia Geary', title: 'Senior Nursery Practitioner', based: 'Caterpillars, ages two to three', qualifications: 'Level 3', joined: '2010', favourite: 'Messy play.', outside: 'Watching television series and films on Netflix.' },
      { name: 'Amie Higham', title: 'Nursery Practitioner', based: 'Caterpillars, ages two to three', qualifications: 'Level 4 Early Years', joined: '2006', favourite: 'Early maths activities.', outside: 'Spending time with her family and taking her children to different activities.' },
