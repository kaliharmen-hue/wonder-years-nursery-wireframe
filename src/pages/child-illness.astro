---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
const base = import.meta.env.BASE_URL;
const publicHealthUrl = 'https://www.gov.uk/government/publications/health-protection-in-schools-and-other-childcare-facilities/public-health-exclusion-periods-in-children-and-young-peoples-settings';

const exclusions = [
  ['Diarrhoea or vomiting', '48 hours after the last episode of diarrhoea or vomiting.'],
  ['Chickenpox', 'Five days after the rash first appears.'],
  ['Hand, foot and mouth disease', 'There is no automatic exclusion period, provided your child is well enough to attend.'],
  ['Conjunctivitis', 'There is no automatic exclusion period, provided your child is well enough to attend.'],
  ['Impetigo', 'When all blisters have formed scabs, or 48 hours after starting antibiotics.'],
  ['Scarlet fever', '24 hours after starting antibiotics.'],
  ['Group A strep', '24 hours after starting antibiotics.'],
  ['Flu', 'When your child is better and no longer has a temperature.'],
  ['COVID-19, RSV or another respiratory infection', 'When symptoms are mild, your child no longer has a high temperature and they are well enough to attend.'],
  ['Ringworm', 'After treatment has started.'],
  ['Scabies', 'For children aged five and under, 24 hours after the first treatment.'],
  ['Measles', 'Four days after the rash began.'],
  ['Mumps', 'Five days after the swelling began.'],
  ['Whooping cough', 'After two days of antibiotics, or 21 days from the start of symptoms if antibiotics are not taken.'],
  ['Head lice', 'There is no exclusion period, although treatment should be started promptly.'],
  ['Slapped cheek', 'There is no exclusion period once the rash appears, provided your child is well enough to attend.'],
  ['Threadworms', 'There is no exclusion period, although treatment and good hygiene are important.'],
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Find out when children should stay at home, what happens if a child becomes unwell at nursery and the current public health exclusion periods for common childhood infections." />
    <title>What Happens if My Child Is Unwell? | The Wonder Years Day Nursery</title>
    <link rel="stylesheet" href={`${base}styles/global.css`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="wireframe-banner">Child illness guidance wireframe · Public health information for parent review</div>
    <SiteHeader current="learning" />
    <main id="main">
      <section class="section hero">
        <div class="container">
          <p class="eyebrow">Learning and care</p>
          <h1>What happens if my child is unwell?</h1>
          <p class="lead">Young children will sometimes pick up minor illnesses and infections, particularly when they spend time playing and learning together.</p>
          <p>To support each child’s recovery and help reduce the spread of infection, children who are unwell may need to remain at home. This page provides general guidance for parents and carers, based on current UK Health Security Agency advice for early years and childcare settings.</p>
          <p class="notice"><strong>This page is not intended to diagnose an illness.</strong> If you are unsure whether your child should attend nursery, please contact the nursery for advice.</p>
          <a class="button" href={`${base}contact/`}>Contact the nursery</a>
        </div>
      </section>

      <section class="section section-muted">
        <div class="container split-grid">
          <div>
            <p class="eyebrow">If illness begins during the day</p>
            <h2>If your child becomes unwell at nursery</h2>
            <p>If your child becomes unwell while attending The Wonder Years, the nursery will contact you by telephone or through the Famly app.</p>
            <p>The team will explain what has happened and discuss the next steps with you. Depending on your child’s symptoms and how they are feeling, you may be asked to collect them.</p>
            <p>Please make sure the nursery always has up-to-date contact details for you and anyone else authorised to collect your child.</p>
            <p>If there is anything specific you need to know about the nursery’s procedures, medication arrangements or your child’s individual circumstances, please contact the nursery directly.</p>
            <a class="button button-secondary" href={`${base}contact/`}>Contact the nursery</a>
          </div>
          <div>
            <p class="eyebrow">When children should stay at home</p>
            <h2>When attendance is not appropriate</h2>
            <p>Children should remain at home when:</p>
            <ul>
              <li>they have a high temperature and are unwell;</li>
              <li>they are not well enough to take part comfortably in the nursery day;</li>
              <li>they have diarrhoea or vomiting;</li>
              <li>they have more than mild symptoms of a respiratory infection;</li>
              <li>they have an infection with a recommended public health exclusion period; or</li>
              <li>a healthcare professional has advised that they should not attend.</li>
            </ul>
            <p>Children with mild respiratory symptoms, such as a runny nose, slight cough or sore throat, can usually attend if they are otherwise well and do not have a high temperature.</p>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <p class="eyebrow">Common illnesses and exclusion periods</p>
          <h2>When can my child return?</h2>
          <p class="section-intro">The table below gives general guidance for some of the illnesses and infections parents most frequently ask about.</p>
          <div class="table-scroll" tabindex="0" aria-label="Scrollable table of common illnesses and exclusion periods">
            <table class="guidance-table">
              <thead><tr><th scope="col">Illness or infection</th><th scope="col">When can my child return?</th></tr></thead>
              <tbody>{exclusions.map(([illness, guidance]) => <tr><th scope="row">{illness}</th><td>{guidance}</td></tr>)}</tbody>
            </table>
          </div>
          <p>This is a short guide rather than a complete list. Some infections require individual medical or public health advice.</p>
          <p class="guidance-update"><strong>Public health guidance can change.</strong> Check the current official exclusion guidance for the latest information.</p>
          <a class="button button-secondary" href={publicHealthUrl} target="_blank" rel="noopener noreferrer">View current public health guidance</a>
        </div>
      </section>

      <section class="section section-accent">
        <div class="container split-grid">
          <div>
            <p class="eyebrow">Diarrhoea and vomiting</p>
            <h2>Allow 48 hours after symptoms stop</h2>
            <p>Children with diarrhoea or vomiting must remain away from nursery until they have been free from both symptoms for at least 48 hours.</p>
            <p>This applies whether the symptoms occur together or separately.</p>
            <p>Parents should seek medical advice if they are concerned about dehydration, symptoms are severe or persistent, or their child appears unusually unwell.</p>
          </div>
          <div>
            <p class="eyebrow">High temperatures and respiratory symptoms</p>
            <h2>Return when well enough</h2>
            <p>A child who is unwell and has a high temperature should stay at home.</p>
            <p>They can usually return when they no longer have a high temperature and are well enough to take part in their normal nursery day.</p>
            <p>Children with only mild respiratory symptoms, such as a runny nose, mild sore throat or slight cough, can usually attend if they are otherwise well and do not have a high temperature.</p>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container split-grid">
          <div>
            <p class="eyebrow">Medication</p>
            <h2>Speak to the nursery first</h2>
            <p>Please speak to the nursery before bringing in any medication.</p>
            <p>Medicines can only be administered in line with the nursery’s procedures and with the required information and permissions in place.</p>
            <p>If your child needs regular medication, emergency medication or support connected with a health condition, contact the nursery so that suitable arrangements can be discussed before they attend.</p>
          </div>
          <div>
            <p class="eyebrow">Let us know about infectious illness</p>
            <h2>Help the nursery respond</h2>
            <p>Please tell the nursery if your child has been diagnosed with an infectious illness, even where no exclusion period is required.</p>
            <p>This helps the team:</p>
            <ul>
              <li>follow current health protection guidance;</li>
              <li>identify possible links between cases;</li>
              <li>take appropriate infection-control measures; and</li>
              <li>provide relevant information to other families where necessary, without identifying your child.</li>
            </ul>
            <p>The nursery may need to seek advice from its local health protection team in some circumstances.</p>
          </div>
        </div>
      </section>

      <section class="section section-muted">
        <div class="container">
          <p class="eyebrow">When to seek medical advice</p>
          <h2>Get help when you are concerned</h2>
          <p>Contact your GP, pharmacist, health visitor or NHS 111 if you are concerned about your child’s symptoms or are unsure what care they need.</p>
          <p><strong>Call 999 in a medical emergency.</strong></p>
          <p>This website cannot assess or diagnose your child’s condition.</p>
        </div>
      </section>

      <section class="final-cta">
        <div class="container">
          <h2>Unsure whether your child should attend?</h2>
          <p>Public health guidance can change, and individual circumstances may need to be considered.</p>
          <p>The Wonder Years follows current UK Health Security Agency guidance. If there is anything specific you need to know about an illness, exclusion period, medication or your child’s individual circumstances, please contact the nursery before bringing them in.</p>
          <div class="button-row centred">
            <a class="button button-light" href={`${base}contact/`}>Contact the nursery</a>
            <a class="button button-outline-light" href="tel:01215566979">Call 0121 556 6979</a>
          </div>
        </div>
      </section>
    </main>
    <SiteFooter />
  </body>
</html>
